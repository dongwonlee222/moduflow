.DS_Store
*.pyc
__pycache__/
vendor/*/
!vendor/README.md

# Derived decision-graph dashboard — regenerated by scripts/project_memory.py --dashboard
memory/dashboard.html

# Derived per-issue artifact panels — regenerated by scripts/project_memory.py --issue <id>
memory/issue-*.html

# Derived per-memory-entry panels — regenerated by scripts/project_memory.py --dashboard
memory/mem-*.html
# machine-local hook state (issue 072) — never commit
.moduflow/state/
.moduflow/logs/

# Playwright MCP working directory (tool cache, not a project artifact)
.playwright-mcp/

# Transaction evidence journals — write-only. Nothing reads them; the recovery
# path reads .moduflow/control/transactions instead. The directory itself must
# stay tracked via .gitkeep: project_lifecycle_transaction.py:6232 refuses to
# plan with PLAN_ARTIFACT_PREREQUISITE_MISSING when it is absent.
workspace/transactions/txn-*.json
